# Bind localhost only
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# PostgreSQL (cache, preferences, action journal)
DATABASE_URL=postgresql+asyncpg://antonio@127.0.0.1:5432/hermesdashboard

# Hermes OpenAI-compatible API (hermes gateway with API_SERVER_ENABLED=true)
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent
# Briefing, Ask, and email triage via `siri --raw`. Set false to keep them on Hermes.
APPLE_INTELLIGENCE=true
# Empty uses `siri` on PATH, then ~/.local/bin/siri.
SIRI_BIN=
SIRI_SHORTCUT=Ask Apple Intelligence (Private Cloud Compute)

# Obsidian Local REST / MCP (streamable HTTP)
OBSIDIAN_MCP_URL=http://127.0.0.1:27123/mcp/
OBSIDIAN_MCP_TOKEN=

# Vault-relative paths
OBSIDIAN_DAILY_FOLDER=📁 500 📒 Notes/📁 510 🧹 Maintenance/📁 511 🔍 Reviews/1. Daily
OBSIDIAN_DAILY_FORMAT=D-YYYY-MM-DD
OBSIDIAN_TEMPLATE_PATH=📁 300 💡 Resources/📁 330 㡯 Templates/Daily Template.md
OBSIDIAN_VAULT_NAME=My Vault
OBSIDIAN_AGENT_RECEIPT_FOLDER=📁 500 📒 Notes/📁 510 🧹 Maintenance/📁 511 🔍 Reviews/Gladys

# OmniFocus
OMNIFOCUS_MCP_COMMAND=/Users/antonio/Dropbox/Code/Python/mcp/omnifocus-mcp/.venv/bin/omnifocus-mcp
OMNIFOCUS_ON_DECK_PERSPECTIVE=On Deck
OMNIFOCUS_TOMORROW_PERSPECTIVE=Tomorrow > 5 minutes
OMNIFOCUS_AGENT_ENABLED=true
OMNIFOCUS_AGENT_TAG=🤖 Gladys
OMNIFOCUS_AGENT_RUNNING_TAG=gladys-running
OMNIFOCUS_AGENT_DONE_TAG=gladys-done
OMNIFOCUS_AGENT_BLOCKED_TAG=gladys-blocked
OMNIFOCUS_AGENT_FAILED_TAG=gladys-failed
OMNIFOCUS_AGENT_POLL_SECONDS=900
OMNIFOCUS_AGENT_TIMEOUT_SECONDS=0
OMNIFOCUS_REVIEW_TAG=🔎 Review

# Fantastical
FANTASTICAL_MCP_COMMAND=/Applications/Fantastical.app/Contents/Helpers/FantasticalMCP.app/Contents/MacOS/FantasticalMCP

# Optional status widgets
KIKODO_CRM_MCP_COMMAND=/Users/antonio/micromamba/envs/kikodo-crm/bin/python
KIKODO_CRM_MCP_ARGS=/Users/antonio/Dropbox/Code/Python/Rocket/git/kikodo-crm/crm_mcp_server.py
KIKODO_CRM_MCP_CWD=/Users/antonio/Dropbox/Code/Python/Rocket/git/kikodo-crm
